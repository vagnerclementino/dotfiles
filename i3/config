# i3 config file (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

# =============================================================================
# Dracula Theme
# =============================================================================
set $bg     #282a36
set $fg     #f8f8f2
set $cyan   #8be9fd
set $green  #50fa7b
set $orange #ffb86c
set $pink   #ff79c6
set $purple #bd93f9
set $red    #ff5555
set $yellow #f1fa8c
set $comment #6272a4

# class                 border   bground  text     indicator  child_border
client.focused          $purple  $bg      $fg      $purple    $purple
client.focused_inactive $comment $bg      $fg      $comment   $comment
client.unfocused        $bg      $bg      $comment $bg        $bg
client.urgent           $red     $red     $fg      $red       $red
client.placeholder      $bg      $bg      $fg      $bg        $bg
client.background       $bg

# =============================================================================
# Fonts: Source Code Pro + Hack
# =============================================================================
font pango:Source Code Pro, Hack, Regular, 10

# =============================================================================
# General
# =============================================================================
set $mod Mod4
floating_modifier $mod

# =============================================================================
# Applications
# =============================================================================
bindsym $mod+Return exec /usr/bin/alacritty
bindsym $mod+q kill
bindsym $mod+Shift+q kill
bindsym $mod+i exec firefox-aurora
bindsym $mod+u exec /usr/bin/thunar
bindsym $mod+m exec /usr/bin/smplayer

# Rofi
bindsym $mod+space exec --no-startup-id rofi -show drun -show-icons -theme ~/.config/rofi/config.rasi

# =============================================================================
# Navigation
# =============================================================================
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+m+Shift+Left move workspace to output left
bindsym $mod+m+Shift+Right move workspace to output right

# =============================================================================
# Layout
# =============================================================================
bindsym $mod+h split v
bindsym $mod+v split h
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# =============================================================================
# Workspaces
# =============================================================================
workspace 1 output LVDS-1
workspace 2 output HDMI-1

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 0

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# =============================================================================
# Resize
# =============================================================================
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym ccedilla resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# =============================================================================
# Session
# =============================================================================
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

set $session_mode "Exit (L)ogout, (R)eboot, (P)oweroff, (S)uspend, (H)ibernate"
mode $session_mode {
        bindsym r exec systemctl reboot
        bindsym l exit
        bindsym p exec systemctl poweroff
        bindsym s exec i3-msg mode "default" && systemctl suspend
        bindsym h exec i3-msg mode "default" && systemctl hibernate
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+E mode $session_mode

# =============================================================================
# Lock Screen (i3lock-color - Dracula)
# =============================================================================
# xss-lock intercepts system lock/sleep and uses our lock script
exec_always --no-startup-id pkill -x xss-lock; xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh &
bindsym $mod+l exec ~/.config/i3/lock.sh

# =============================================================================
# Hardware keys
# =============================================================================
bindsym XF86MonBrightnessUp exec light -A 5
bindsym XF86MonBrightnessDown exec light -U 5
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ '-5%'
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ '+5%'
bindsym XF86HomePage exec ~/.config/i3/touchpad_toggle.sh

# =============================================================================
# Startup
# =============================================================================
exec_always --no-startup-id feh --bg-fill ~/.config/i3/img/bg.jpg
exec_always --no-startup-id mpd ~/.config/mpd/mpd.conf
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always --no-startup-id nm-applet
exec_always --no-startup-id ~/.config/conky/conky-toggle.sh
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b
exec --no-startup-id i3-msg 'workspace 1; exec /usr/bin/firefox-aurora'
exec --no-startup-id /usr/libexec/geoclue-2.0/demos/agent
exec --no-startup-id volumeicon
exec --no-startup-id blueman-tray

# =============================================================================
# Appearance
# =============================================================================
for_window [class=".*"] border pixel 2
popup_during_fullscreen smart
focus_follows_mouse no
smart_gaps inverse_outer
smart_gaps on
gaps inner 5
gaps outer 5
gaps bottom 0
gaps top 0
